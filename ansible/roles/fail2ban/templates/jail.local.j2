[DEFAULT]
# Ban hosts for one hour
bantime = 3600
# Override /etc/fail2ban/jail.d/00-firewalld.conf:
banaction = iptables-multiport
# A host is banned if it has generated "maxretry" during "findtime" seconds
findtime = 600
maxretry = 5

[sshd]
enabled = {{ 'true' if fail2ban_ssh_enabled else 'false' }}
port = ssh
logpath = /var/log/secure
maxretry = {{ fail2ban_ssh_maxretry }}
bantime = {{ fail2ban_ssh_bantime }}
findtime = {{ fail2ban_ssh_findtime }}
